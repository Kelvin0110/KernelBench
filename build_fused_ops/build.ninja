ninja_required_version = 1.3
cxx = c++
nvcc = /localhome/local-tianzheng/opt/cuda-12.8/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=fused_bias_tanh_scale -DTORCH_API_INCLUDE_EXTENSION_H -isystem /localhome/local-tianzheng/KernelBench/.claude/worktrees/l2-redesign/.venv/lib/python3.10/site-packages/torch/include -isystem /localhome/local-tianzheng/KernelBench/.claude/worktrees/l2-redesign/.venv/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /localhome/local-tianzheng/opt/cuda-12.8/include -isystem /localhome/local-tianzheng/.local/share/uv/python/cpython-3.10-linux-aarch64-gnu/include/python3.10 -fPIC -std=c++17 -O3
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=fused_bias_tanh_scale -DTORCH_API_INCLUDE_EXTENSION_H -isystem /localhome/local-tianzheng/KernelBench/.claude/worktrees/l2-redesign/.venv/lib/python3.10/site-packages/torch/include -isystem /localhome/local-tianzheng/KernelBench/.claude/worktrees/l2-redesign/.venv/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /localhome/local-tianzheng/opt/cuda-12.8/include -isystem /localhome/local-tianzheng/.local/share/uv/python/cpython-3.10-linux-aarch64-gnu/include/python3.10 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_90,code=compute_90 -gencode=arch=compute_90,code=sm_90 --compiler-options '-fPIC' -O3 -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/localhome/local-tianzheng/KernelBench/.claude/worktrees/l2-redesign/.venv/lib/python3.10/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/localhome/local-tianzheng/opt/cuda-12.8/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc -MD -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build fused_bias_tanh_scale.o: compile /localhome/local-tianzheng/KernelBench/.claude/worktrees/l2-redesign/build_fused_ops/fused_bias_tanh_scale.cpp
build fused_bias_tanh_scale.cuda.o: cuda_compile /localhome/local-tianzheng/KernelBench/.claude/worktrees/l2-redesign/build_fused_ops/fused_bias_tanh_scale.cu





build fused_bias_tanh_scale.so: link fused_bias_tanh_scale.o fused_bias_tanh_scale.cuda.o

default fused_bias_tanh_scale.so
